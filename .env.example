# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8081

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_agent_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=super-secret-jwt-access-key-minimum-32-chars-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-minimum-32-chars-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 / S3 Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=sales-agent-bucket
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# AI Provider Configuration (Gemini)
AI_DEFAULT_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Super Admin Initial Seed Credentials (Used by seed script only)
SUPER_ADMIN_PHONE=+919999999999
SUPER_ADMIN_PASSWORD=SuperAdmin@SecurePass123!
SUPER_ADMIN_NAME=Platform Administrator

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Business Analyst Configuration (Feature 02)
BUSINESS_ANALYST_CACHE_TTL=900
BUSINESS_ANALYST_MAX_QUESTION_LENGTH=2000
DEFAULT_TIMEZONE=Asia/Kolkata
